{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "profile": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['name', 'phone'])"
        },
        "balance": {
          ".write": false
        },
        "transactions": {
          ".write": false
        }
      }
    }
  }
}
