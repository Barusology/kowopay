# Client-safe Flutterwave configuration for local test builds.
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your-public-key
FLUTTERWAVE_REDIRECT_URL=https://your-verified-callback.example
FLUTTERWAVE_TEST_MODE=true

# GEMINI_API_KEY is intentionally not consumed by the Flutter client.
# Store it only in the trusted server or Cloud Function environment.
