# Build-time configuration for the Flutter client.
#
# Pass these with:
#   flutter run --dart-define-from-file=.env
# or individually with --dart-define=NAME=value.
#
# Only PUBLIC values belong here. Secret keys (Gemini, Flutterwave secret,
# webhook hash) live in Cloud Functions environment variables, never in the app.

# Flutterwave public key (safe to expose; injected per environment).
FLUTTERWAVE_PUBLIC_KEY=

# Where Flutterwave returns the user after checkout.
FLUTTERWAVE_REDIRECT_URL=https://kowopay.web.app/payment-callback

# Set to false only for live payments.
FLUTTERWAVE_TEST_MODE=true

# Must match the region where functions are deployed.
FUNCTIONS_REGION=us-central1
