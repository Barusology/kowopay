# Copy to functions/.env and fill from your own secret manager / Firebase console.
# NEVER commit the real values.

# Google AI Studio key used by the aiAdvice function only.
GEMINI_API_KEY=

# Flutterwave dashboard: Settings > Webhooks > Secret hash.
FLUTTERWAVE_SECRET_HASH=

# Flutterwave secret key, used to re-verify transactions before crediting.
FLUTTERWAVE_SECRET_KEY=

# Optional: model override for aiAdvice.
GEMINI_MODEL=gemini-2.0-flash

# Optional: region for all functions (must match FUNCTIONS_REGION in the app build).
FUNCTIONS_REGION=us-central1

# Optional bootstrap: this email may grant itself the admin claim once.
# Remove after the first admin exists.
BOOTSTRAP_ADMIN_EMAIL=
